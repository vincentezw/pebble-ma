{
  "name": "musicassistant",
  "author": "vincentezw",
  "version": "2.0.0",
  "keywords": [
    "pebble-app",
    "music",
    "Music Assistant"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "Pebble MA",
    "uuid": "22336b52-d338-4e55-82cf-1b99f129d700",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "COMMAND",
      "DATA"
    ],
    "capabilities": [
      "configurable"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "ACTION_BAR",
          "file": "action_bar.png"
        },
        {
          "type": "bitmap",
          "name": "CASSETTE",
          "file": "cassette.png"
        },
        {
          "type": "bitmap",
          "name": "NOCASETTE",
          "file": "no_cassette.png"
        },
        {
          "type": "bitmap",
          "name": "ICONSPEAKER",
          "file": "icon_speaker.png"
        },
        {
          "type": "bitmap",
          "name": "PLAY_BAR",
          "file": "play_bar.png"
        },
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "music_assistant.png",
          "menuIcon": true
        }
      ]
    }
  }
}
